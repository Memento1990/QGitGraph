{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the local main window can invoke explicitly listed application commands.",
  "windows": ["main"],
  "permissions": ["core:default", "allow-app-commands", "core:window:allow-minimize", "core:window:allow-toggle-maximize", "core:window:allow-close", "core:window:allow-start-dragging", "core:window:allow-is-maximized"]
}
