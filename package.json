{
  "name": "qgitgraph",
  "version": "0.2.2",
  "license": "MIT",
  "private": true,
  "description": "A small, independent desktop Git history client.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 14730 --strictPort",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "tauri build --bundles nsis -- --bin qgitgraph"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
